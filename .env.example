# Phase 8B - PostgreSQL credentials for the docker-compose PostgreSQL overlay.
#
# Copy this file to `.env` and set a strong POSTGRES_PASSWORD before running:
#
#   cp .env.example .env
#   docker compose -f docker-compose.yml -f docker-compose.postgres.yml up --build
#
# `.env` is git-ignored (see .gitignore). NEVER commit real credentials.
# These variables are consumed by both the `postgres` and `backend` services.

POSTGRES_DB=ics_alerts
POSTGRES_USER=ics_app
POSTGRES_PASSWORD=change-me-to-a-strong-password

# --------------------------------------------------------------------------- #
# Email alerting — notify the admin when a NEW active anomaly is opened.
#
# OPT-IN: the backend sends email ONLY when ALERT_EMAIL_ENABLED is truthy AND
# host/from/to are set; otherwise it behaves exactly as before (no SMTP). One
# email is sent per incident (deduplicated), not per anomalous window, and the
# send runs off the request path so /score is never blocked. `.env` is
# git-ignored — NEVER commit a real SMTP password.
#
# Gmail example (use a 16-char App Password, not your account password):
#   ALERT_EMAIL_ENABLED=true
#   ALERT_EMAIL_SMTP_HOST=smtp.gmail.com
#   ALERT_EMAIL_SMTP_PORT=587
#   ALERT_EMAIL_USERNAME=you@gmail.com
#   ALERT_EMAIL_PASSWORD=your-16-char-app-password
#   ALERT_EMAIL_FROM=you@gmail.com
#   ALERT_EMAIL_TO=admin@example.com
ALERT_EMAIL_ENABLED=false
ALERT_EMAIL_SMTP_HOST=
ALERT_EMAIL_SMTP_PORT=587
ALERT_EMAIL_USERNAME=
ALERT_EMAIL_PASSWORD=
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=
# STARTTLS on a submission port (587): on by default. Set ALERT_EMAIL_USE_SSL=true
# instead for implicit TLS / SMTPS (usually port 465).
ALERT_EMAIL_USE_TLS=true
ALERT_EMAIL_USE_SSL=false
ALERT_EMAIL_TIMEOUT=10
# Only email at/above this heuristic severity: LOW (default) | MEDIUM | HIGH.
ALERT_EMAIL_MIN_SEVERITY=LOW
