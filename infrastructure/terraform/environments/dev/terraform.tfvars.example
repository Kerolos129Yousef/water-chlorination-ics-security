# Copy to terraform.tfvars and adjust. terraform.tfvars is git-ignored
# (only *.tfvars.example templates are committed).

project             = "ics-guardian"
environment         = "dev"
region              = "eu-central-1"
instance_type       = "t3.small"
root_volume_size_gb = 30

# --------------------------------------------------------------------------
# Ingress is SAFE BY DEFAULT: if you leave dashboard_ingress_cidrs unset (or
# empty), NO public ingress rule is created and the instance is reachable only
# via SSM Session Manager. You MUST deliberately opt in to open ports 80/8000.
#
# Recommended: your own public IP only. Find it with:  curl -s https://checkip.amazonaws.com
#   dashboard_ingress_cidrs = ["YOUR.PUBLIC.IP.HERE/32"]
#
# Public demo — OWNER-APPROVED 2026-10-10: opens ONLY port 80 (the nginx web
# entry point) to the whole internet. Port 8000 (API) and 5432 (Postgres) are
# never opened by the security group. HTTP only, no auth -> synthetic data only.
#   dashboard_ingress_cidrs = ["0.0.0.0/0"]
#
# Left intentionally EMPTY here so copying this file does not silently expose the
# instance. The approved public value is passed explicitly at apply instead:
#   terraform apply -var='dashboard_ingress_cidrs=["0.0.0.0/0"]'
dashboard_ingress_cidrs = []
